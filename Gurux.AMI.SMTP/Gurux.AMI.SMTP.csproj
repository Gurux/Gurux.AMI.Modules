<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <AmiModuleCompatibilityMetadata>true</AmiModuleCompatibilityMetadata>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <Description>Gurux.AMI.SMTP adds SMTP support for Gurux DLMS AMI.</Description>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' == '' ">0.0.1-local</Version>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' != '' ">$(BUILD_BUILDNUMBER)</Version>
        <Version Condition="'$(AmiModuleReleaseVersion)' != ''">$(AmiModuleReleaseVersion)</Version>
        <PackageTags>Gurux Device Framework Network DLMS AMI</PackageTags>
        <PackageId>Gurux.AMI.SMTP</PackageId>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    </PropertyGroup>
    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Gurux.DLMS.AMI.Http" Version="4.1.2611.501" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.14" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Gurux.UI.Components" Version="4.0.2611.1101" />
        <PackageReference Include="Gurux.DLMS.AMI.Module" Version="5.0.2611.902" />
        <PackageReference Include="Gurux.DLMS.AMI.Services" Version="4.1.2611.501" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Target Name="ZipPublish" AfterTargets="Publish">
        <MakeDir Directories="$(AMIModuleArchiveDirectory)" />
        <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(AMIModuleArchiveDirectory)/$(PackageId)-$(Version).zip" Overwrite="true" />
    </Target>
  <ItemGroup>
    <EmbeddedResource Include="Help/*.md" LogicalName="$(AssemblyName).Help.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>


