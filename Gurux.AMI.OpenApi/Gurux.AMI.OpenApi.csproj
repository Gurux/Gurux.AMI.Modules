<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <AmiModuleCompatibilityMetadata>true</AmiModuleCompatibilityMetadata>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.0.1-local</Version>
        <Version Condition="'$(AmiModuleReleaseVersion)' != ''">$(AmiModuleReleaseVersion)</Version>
        <PackageId>Gurux.AMI.OpenApi</PackageId>
        <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
        <Description>Optional AMI OpenApi documentation module.</Description>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
      <Content Remove="C:\Users\Mikko\.nuget\packages\gurux.dlms.ami.module\4.1.2611.201\contentFiles\any\net10.0\Properties\launchSettings.json" />
    </ItemGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Gurux.UI.Components" Version="4.0.2611.902" />
    <PackageReference Include="Gurux.DLMS.AMI.Module" Version="5.0.2611.902" />
        <PackageReference Include="Gurux.DLMS.AMI.Shared" Version="4.1.2611.901" />
        <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Properties/Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <Compile Update="Properties/Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Target Name="ZipPublish" AfterTargets="Publish">
        <MakeDir Directories="$(AMIModuleArchiveDirectory)" />
        <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(AMIModuleArchiveDirectory)/$(PackageId)-$(Version).zip" Overwrite="true" />
    </Target>
  <ItemGroup>
    <EmbeddedResource Include="Help/*.md" LogicalName="$(AssemblyName).Help.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
